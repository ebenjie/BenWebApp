@model IEnumerable<BenWebApp.Models.NewItemCSRModel>

<h2>New Item Code - CSR</h2>

<div class="container">
	<table class="table table-bordered">
		<thead class="table-light">
			<tr>
				<th>Item Code</th>
				<th>Item Description</th>
				<th>Item Category</th>
				<th>Conversion</th>
				<th>Unit Cost</th>
				<th>Small Unit</th>
				<th>Big Unit</th>
				<th>Mark Up</th>
				<th>Selling Price</th>
				<th>Requested By</th>
				<th>Request Date</th>
				<th>Status</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<td>@item.ItemCode</td>
					<td>@item.Description</td>
					<td>@item.ItemCategory</td>
					<td>@item.Conversion</td>
					<td>@item.UnitCost</td>
					<td>@item.SmallUnit</td>
					<td>@item.BigUnit</td>
					<td>@item.MarkUp</td>
					<td>@item.SellingPrice</td>
					<td>@item.RequestedBy</td>
					<td>@item.RequestDate.ToString("MM-dd-yyyy")</td>
					<td>@item.IT_Status</td>
					<td>
						@if (item.IT_Status == "Open" && (ViewBag.UserRole == "IT"))
						{
							<a asp-controller="NewItemCSR"
							   asp-action="CloseItem"
							   asp-route-id="@item.Id"
							   class="btn btn-sm btn-danger"
							   onclick="return confirm('Confirm close w/ Item Code @item.ItemCode ?');">
								Close
							</a>
						}
						else if (item.IT_Status == "Closed")
						{
							<span class="text-success">Closed</span>
						}
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>